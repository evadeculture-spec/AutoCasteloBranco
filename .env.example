# ---------------------------------------------------------------
# Auto Castelo Branco — configuração do website
# Copiar para .env.local (desenvolvimento) ou definir no alojamento.
# Todos os valores vazios são tratados como "por configurar":
# o website mostra um placeholder identificado e não gera links.
# ---------------------------------------------------------------

# URL público definitivo (sem barra final). Usado em SEO, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=

# Modo de demonstração. Enquanto for diferente de "false":
#  - é mostrada uma faixa a indicar que o conteúdo é demonstrativo;
#  - o site pede aos motores de pesquisa para não indexar (noindex);
#  - as viaturas marcadas como demo continuam visíveis.
# Só mudar para "false" depois de validar dados, viaturas e contactos reais.
NEXT_PUBLIC_DEMO_MODE=true

# Contactos (formato internacional para o telefone, ex.: +351272000000)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Número de WhatsApp em formato internacional, só dígitos (ex.: 351910000000).
# Vazio = o botão de WhatsApp não é mostrado.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Morada validada. Só quando a rua estiver preenchida é mostrado o acesso ao mapa.
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_LOCALITY=Castelo Branco

# Horário, linhas separadas por "|" (ex.: Segunda a sexta: 09:00–19:00|Sábado: 09:00–13:00)
NEXT_PUBLIC_OPENING_HOURS=

# Identificação legal (obrigatória antes de publicar)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_NIF=

# Entrega de pedidos (servidor). URL de um webhook que recebe JSON
# (ex.: CRM, Make, Zapier, n8n, função própria). Vazio = modo demonstração:
# os pedidos são validados mas NÃO são entregues a ninguém.
LEADS_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho "X-Webhook-Secret".
LEADS_WEBHOOK_SECRET=
